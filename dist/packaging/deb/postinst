#!/bin/sh
# As dh_installsystemd does it: enable the service on the first install (unless the admin
# disabled it before), start it, and restart it on upgrades. The Debian package's config
# puts every network in monitor mode, so starting it denies nothing until the admin
# says so. deb-systemd-invoke leaves a disabled service alone.
set -e

case "$1" in
  configure | abort-upgrade | abort-deconfigure | abort-remove)
    if [ -x /usr/bin/deb-systemd-helper ]; then
      # Only removes the mask postrm made on removal.
      deb-systemd-helper unmask portcullis.service >/dev/null || true
      # was-enabled is true on a first install.
      if deb-systemd-helper --quiet was-enabled portcullis.service; then
        deb-systemd-helper enable portcullis.service >/dev/null || true
      else
        deb-systemd-helper update-state portcullis.service >/dev/null || true
      fi
    fi
    if [ -d /run/systemd/system ]; then
      systemctl --system daemon-reload >/dev/null || true
      if [ -n "$2" ]; then action=restart; else action=start; fi
      deb-systemd-invoke "${action}" portcullis.service >/dev/null || true
    fi
    ;;
esac
